# 统一换行符：CI 在 Linux 上跑，CRLF 会让 shell 脚本直接失败
* text=auto

*.sh                text eol=lf
*.py                text eol=lf
*.yml               text eol=lf
*.yaml              text eol=lf
*.sc                text eol=lf
*.json              text eol=lf
*.md                text eol=lf

# fnOS fpk 里的脚本与配置必须是 LF
deploy/fnos/fpk/manifest        text eol=lf
deploy/fnos/fpk/cmd/*           text eol=lf
deploy/fnos/fpk/config/*        text eol=lf
deploy/fnos/fpk/ui/config       text eol=lf

# 二进制不要转换
*.PNG   binary
*.png   binary
*.jpg   binary
*.gz    binary
*.fpk   binary
*.npz   binary

# Windows 脚本必须保持 CRLF，否则 cmd.exe 解析出错（陷阱 14）。
# 原来只有 `* text=auto`，git 在 Linux/CI 检出时会把 CRLF 转成 LF，
# 于是本地过、CI 报「启动器不是 CRLF」——实测踩过。
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.vbs   text eol=crlf
*.ps1   text eol=crlf
