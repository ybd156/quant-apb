#!/bin/bash
# 卸载回调：停止并移除容器（保留数据目录，由用户决定是否删除）
CMD_DIR="$(cd "$(dirname "$0")" && pwd)"
[ -r "${CMD_DIR}/common" ] && . "${CMD_DIR}/common"
[ -r "${CMD_DIR}/service-setup" ] && . "${CMD_DIR}/service-setup"
log "卸载 ${APPNAME}：停止并移除容器（数据保留在 ${PKGVAR:-?}）"
docker stop "${CONTAINER:-apb}" >>"${LOG_FILE:-/dev/null}" 2>&1 || true
docker rm -f "${CONTAINER:-apb}" >>"${LOG_FILE:-/dev/null}" 2>&1 || true
exit 0
