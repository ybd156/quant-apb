#!/bin/bash
# APB 服务控制：Docker 后端
# 由 cmd/main 通过 source 引入，需提供 start_daemon / stop_daemon / daemon_status

CONTAINER="${APPNAME:-apb}"
IMAGE="${APB_IMAGE:-ghcr.io/ybd156/quant-apb:latest}"
DATA_DIR="${PKGVAR:-/tmp}/data"
LOG_HOST_DIR="${PKGVAR:-/tmp}/logs"
PORT="${APB_PORT:-8765}"

docker_available() {
    command -v docker >/dev/null 2>&1
}

daemon_status() {
    docker_available || return 1
    docker ps --filter "name=^${CONTAINER}$" --filter "status=running" -q | grep -q .
}

start_daemon() {
    if ! docker_available; then
        log "docker 不可用，无法启动"
        return 1
    fi
    mkdir -p "$DATA_DIR" "$LOG_HOST_DIR"
    if docker ps -a --format '{{.Names}}' | grep -qx "$CONTAINER"; then
        docker start "$CONTAINER" >>"$LOG_FILE" 2>&1
    else
        docker run -d --name "$CONTAINER" --pull=missing \
            --restart unless-stopped \
            -p "${PORT}:8765" \
            -e TZ=Asia/Shanghai \
            -e APB_HOST=0.0.0.0 \
            -v "${DATA_DIR}:/app/data" \
            -v "${LOG_HOST_DIR}:/app/logs" \
            "$IMAGE" >>"$LOG_FILE" 2>&1
    fi
    log "APB 已启动，端口 ${PORT}"
}

stop_daemon() {
    docker_available || return 0
    docker stop "$CONTAINER" >>"$LOG_FILE" 2>&1 || true
    log "APB 已停止"
}
